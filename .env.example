# .env dosyası için örnek şablon — sunucuda bunu .env olarak kopyalayın
# cp .env.example .env

# PostgreSQL bağlantısı: sağlayıcı DATABASE_URL veriyorsa onu kullanın.
# Supabase örneği: Supabase Connect ekranındaki Session pooler URI'sini alın.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Harici sağlayıcı TLS istiyorsa true yapın (Supabase için).
DATABASE_URL=
DATABASE_SSL=false

# DATABASE_URL boşsa aşağıdaki ayrı ayarlar kullanılır.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_takip
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Uygulama Ayarları
PORT=9999
NODE_ENV=production
